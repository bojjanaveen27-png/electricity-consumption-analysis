# Electricity Consumption Analysis System - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Database Engine: 'mysql' (default) or 'sqlite'
DB_ENGINE=mysql

# MySQL Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=electricity_analysis

# Application Settings
FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_PORT=5000
FLASK_DEBUG=True

# Analytical Threshold (kWh per consumer per month)
HIGH_USAGE_THRESHOLD_KWH=500.0

# Authentication & Access Security (Login Password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_your_secure_password

